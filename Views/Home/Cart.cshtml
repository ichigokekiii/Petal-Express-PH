@{
    ViewBag.Title = "Shopping Cart";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 py-12">
    <div class="container mx-auto px-6 max-w-6xl">
        
        <!-- Page Header -->
        <div class="text-center mb-12">
            <h1 class="text-5xl font-black text-[#536FA3] mb-4">Your Shopping Cart</h1>
            <p class="text-xl text-gray-600">Review your items before checkout</p>
        </div>

        <!-- Cart Content -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            <!-- Cart Items (Left Side) -->
            <div class="lg:col-span-2">
                <div id="cartItemsContainer" class="space-y-4">
                    <!-- Cart items will be dynamically loaded here -->
                </div>

                <!-- Empty Cart State -->
                <div id="emptyCartState" class="hidden bg-white rounded-2xl shadow-lg p-12 text-center">
                    <svg class="w-32 h-32 mx-auto text-gray-300 mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                    </svg>
                    <h3 class="text-3xl font-black text-gray-800 mb-3">Your Cart is Empty</h3>
                    <p class="text-gray-600 text-lg mb-6">Add some beautiful flowers to get started!</p>
                    <a href="@Url.Action("Shop", "Home")" class="inline-block px-8 py-3 bg-[#5977AF] text-white font-semibold rounded-lg hover:bg-[#4a6199] transition">
                        Browse Products
                    </a>
                </div>
            </div>

            <!-- Order Summary (Right Side) -->
            <div class="lg:col-span-1">
                <div id="orderSummary" class="bg-white rounded-2xl shadow-lg p-6 sticky top-6">
                    <h2 class="text-2xl font-black text-gray-800 mb-6">Order Summary</h2>
                    
                    <div class="space-y-3 mb-6">
                        <div class="flex justify-between text-gray-700">
                            <span>Subtotal</span>
                            <span class="font-semibold" id="subtotalAmount">0.00</span>
                        </div>
                        <div class="flex justify-between text-gray-700">
                            <span>Delivery Fee</span>
                            <span class="font-semibold">50.00</span>
                        </div>
                        <div class="border-t pt-3 flex justify-between text-xl font-black text-[#5977AF]">
                            <span>Total</span>
                            <span id="totalAmount">50.00</span>
                        </div>
                    </div>

                    <button onclick="proceedToCheckout()" id="checkoutBtn" class="w-full px-6 py-4 bg-[#5977AF] text-white font-bold rounded-lg hover:bg-[#4a6199] transition transform hover:scale-105 mb-3">
                        Proceed to Checkout
                    </button>

                    <a href="@Url.Action("Shop", "Home")" class="block w-full px-6 py-3 bg-gray-200 text-gray-700 font-semibold rounded-lg hover:bg-gray-300 transition text-center">
                        Continue Shopping
                    </a>
                </div>
            </div>

        </div>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    // Load cart from localStorage
    let cart = JSON.parse(localStorage.getItem('petalExpressCart')) || [];

    // Initialize cart display
    displayCart();

    function displayCart() {
        const container = document.getElementById('cartItemsContainer');
        const emptyState = document.getElementById('emptyCartState');
        const orderSummary = document.getElementById('orderSummary');

        if (cart.length === 0) {
            container.classList.add('hidden');
            emptyState.classList.remove('hidden');
            orderSummary.classList.add('hidden');
            return;
        }

        container.classList.remove('hidden');
        emptyState.classList.add('hidden');
        orderSummary.classList.remove('hidden');

        // Build cart HTML
        let html = '';
        let subtotal = 0;

        cart.forEach((item, index) => {
            const itemTotal = item.price * item.quantity;
            subtotal += itemTotal;

            html += `
                <div class="bg-white rounded-2xl shadow-lg p-6 flex items-center gap-6">
                    <div class="flex-1">
                        <h3 class="text-xl font-bold text-gray-800 mb-2">${item.name}</h3>
                        <p class="text-2xl font-black text-[#5977AF]">${item.price.toFixed(2)}</p>
                    </div>

                    <div class="flex items-center gap-3">
                        <button onclick="updateQuantity(${index}, -1)" class="w-10 h-10 bg-gray-200 rounded-full hover:bg-gray-300 transition font-bold text-xl">
                            -
                        </button>
                        <span class="text-2xl font-bold text-gray-800 w-12 text-center">${item.quantity}</span>
                        <button onclick="updateQuantity(${index}, 1)" class="w-10 h-10 bg-[#5977AF] text-white rounded-full hover:bg-[#4a6199] transition font-bold text-xl">
                            +
                        </button>
                    </div>

                    <div class="text-right">
                        <p class="text-sm text-gray-500 mb-1">Subtotal</p>
                        <p class="text-2xl font-black text-gray-800">${itemTotal.toFixed(2)}</p>
                    </div>

                    <button onclick="removeItem(${index})" class="ml-4 p-3 bg-red-500 text-white rounded-lg hover:bg-red-600 transition">
                        Remove
                    </button>
                </div>
            `;
        });

        container.innerHTML = html;
        updateOrderSummary(subtotal);
    }

    function updateOrderSummary(subtotal) {
        const deliveryFee = 50;
        const total = subtotal + deliveryFee;

        document.getElementById('subtotalAmount').textContent = subtotal.toFixed(2);
        document.getElementById('totalAmount').textContent = total.toFixed(2);
    }

    function updateQuantity(index, change) {
        cart[index].quantity += change;

        if (cart[index].quantity < 1) {
            cart[index].quantity = 1;
        }

        localStorage.setItem('petalExpressCart', JSON.stringify(cart));
        displayCart();
    }

    function removeItem(index) {
        Swal.fire({
            title: 'Remove Item?',
            text: `Remove ${cart[index].name} from your cart?`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ef4444',
            cancelButtonColor: '#6b7280',
            confirmButtonText: 'Yes, remove it!'
        }).then((result) => {
            if (result.isConfirmed) {
                cart.splice(index, 1);
                localStorage.setItem('petalExpressCart', JSON.stringify(cart));
                displayCart();

                Swal.fire({
                    title: 'Removed!',
                    text: 'Item removed from cart.',
                    icon: 'success',
                    confirmButtonColor: '#5977AF',
                    timer: 1500,
                    showConfirmButton: false
                });
            }
        });
    }

    function proceedToCheckout() {
        if (cart.length === 0) {
            Swal.fire({
                title: 'Cart is Empty',
                text: 'Please add items to your cart first!',
                icon: 'warning',
                confirmButtonColor: '#5977AF'
            });
            return;
        }

        // Check if user is logged in
        fetch('@Url.Action("CheckSession", "Home")')
            .then(response => response.json())
            .then(data => {
                if (data.isLoggedIn) {
                    window.location.href = '@Url.Action("Checkout", "Home")';
                } else {
                    Swal.fire({
                        title: 'Login Required',
                        text: 'Please login to proceed with checkout.',
                        icon: 'info',
                        showCancelButton: true,
                        confirmButtonColor: '#5977AF',
                        confirmButtonText: 'Login Now'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = '@Url.Action("Login", "Home")';
                        }
                    });
                }
            });
    }
</script>
