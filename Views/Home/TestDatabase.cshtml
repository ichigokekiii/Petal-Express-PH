@{
    ViewBag.Title = "Database Connection Test";
}

<div class="container mx-auto px-6 py-20">
    <div class="max-w-2xl mx-auto">
        <h1 class="text-4xl font-black text-[#27334B] text-center mb-8">Database Connection Test</h1>
        
        @if (ViewBag.Success != null)
        {
            if (ViewBag.Success)
            {
                <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-4 mb-4" role="alert">
                    <p class="font-bold text-2xl">@ViewBag.Message</p>
                    <p class="mt-4">Connection to MySQL database is working!</p>
                </div>

                <div class="bg-white shadow-md rounded-lg p-6 mt-6">
                    <h2 class="text-2xl font-bold text-[#27334B] mb-4">Database Statistics:</h2>
                    <ul class="space-y-2">
                        <li class="flex justify-between border-b py-2">
                            <span class="font-semibold">Users:</span>
                            <span class="text-[#5977AF]">@ViewBag.UserCount records</span>
                        </li>
                        <li class="flex justify-between border-b py-2">
                            <span class="font-semibold">Products:</span>
                            <span class="text-[#5977AF]">@ViewBag.ProductCount records</span>
                        </li>
                        <li class="flex justify-between border-b py-2">
                            <span class="font-semibold">Categories:</span>
                            <span class="text-[#5977AF]">@ViewBag.CategoryCount records</span>
                        </li>
                    </ul>
                </div>

                <div class="mt-6 text-center">
                    <a href="@Url.Action("Index", "Home")" class="px-8 py-3 bg-[#5977AF] text-white font-semibold rounded-full">
                        Connection Successful! Go to Homepage
                    </a>
                </div>
            }
            else
            {
                <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-4" role="alert">
                    <p class="font-bold text-2xl">@ViewBag.Message</p>
                    <p class="mt-4">Please check the error details below:</p>
                </div>

                <div class="bg-white shadow-md rounded-lg p-6 mt-6">
                    <h2 class="text-xl font-bold text-red-600 mb-4">Error Details:</h2>
                    <div class="bg-gray-100 p-4 rounded mb-4">
                        <p class="font-semibold mb-2">Main Error:</p>
                        <p class="text-sm font-mono">@ViewBag.Error</p>
                    </div>
                    <div class="bg-gray-100 p-4 rounded">
                        <p class="font-semibold mb-2">Inner Error:</p>
                        <p class="text-sm font-mono">@ViewBag.InnerError</p>
                    </div>
                </div>

                <div class="mt-6 bg-yellow-50 border border-yellow-200 rounded-lg p-4">
                    <h3 class="font-bold text-yellow-800 mb-2">Common Issues:</h3>
                    <ul class="list-disc list-inside text-sm text-yellow-800 space-y-1">
                        <li>Is XAMPP MySQL running?</li>
                        <li>Is the connection string password correct in Web.config?</li>
                        <li>Is the database name "3ite_db" correct?</li>
                        <li>Did you install MySql.Data.EntityFramework NuGet package?</li>
                        <li>Are all Model, Map, and Context files added to your project?</li>
                    </ul>
                </div>
            }
        }
        else
        {
            <div class="bg-blue-100 border-l-4 border-blue-500 text-blue-700 p-4" role="alert">
                <p class="font-bold">Ready to test database connection...</p>
                <p class="mt-2">Refresh this page to test the connection.</p>
            </div>
        }

        <div class="mt-8 text-center">
            <button onclick="location.reload()" class="px-6 py-2 bg-gray-500 text-white rounded-full hover:bg-gray-600">
                Refresh & Test Again
            </button>
        </div>
    </div>
</div>
