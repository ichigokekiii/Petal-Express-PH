@{
    ViewBag.Title = "Product Detail";
}

<div class="bg-white" ng-controller="productDetailController" ng-init="init('@ViewBag.ProductId')">
    <div class="container mx-auto px-6 py-12" ng-if="product">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">

            <div>
                <div class="bg-[#DFEDF9] rounded-2xl p-4 h-[420px] flex items-center justify-center overflow-hidden" data-aos="fade-up" data-aos-duration="600">
                    <img ng-if="product.ImagePath" ng-src="{{product.ImagePath}}" class="w-full h-full object-cover rounded-xl" />
                </div>
                <div class="flex gap-3 mt-3">
                    <div class="w-14 h-14 bg-[#DFEDF9] rounded-xl"></div>
                    <div class="w-14 h-14 bg-[#DFEDF9] rounded-xl"></div>
                </div>

                <div class="mt-8" data-aos="fade-up" data-aos-delay="100" data-aos-duration="600">
                    <h2 class="text-lg font-bold text-[#27334B]">Product Description</h2>
                    <p class="mt-3 text-gray-600">{{product.Description}}</p>
                </div>
            </div>

            <div>
                <div class="sticky top-36">
                    <h1 class="text-2xl md:text-3xl font-black text-[#27334B]">{{product.Name}}</h1>
                    <div class="text-xl font-bold text-[#27334B] mt-2">$ {{product.Price | number:2}}</div>
                    <div class="flex items-center mt-2 text-sm">
                        <span class="text-yellow-400">★★★★☆</span>
                        <span class="ml-2 text-gray-500">(22)</span>
                        <button class="ml-auto text-gray-400 hover:text-red-500" aria-label="favorite">❤</button>
                    </div>

                    <div class="mt-6">
                        <p class="text-sm font-semibold text-gray-700">Select type</p>
                        <div class="mt-2 flex gap-3">
                            <button class="px-4 py-2 bg-[#5977AF] text-white rounded-full text-sm">Pre-made</button>
                            <button class="px-4 py-2 bg-[#5977AF] text-white rounded-full text-sm">Custom</button>
                        </div>
                    </div>

                    <div class="mt-6">
                        <p class="text-sm font-semibold text-gray-700">Quantity</p>
                        <div class="flex items-center gap-4 mt-2">
                            <button class="h-8 w-8 border rounded-full font-bold" ng-click="qty = Math.max(1, qty-1)">−</button>
                            <input type="number" min="1" class="w-16 text-center border rounded-full px-3 py-1" ng-model="qty" />
                            <button class="h-8 w-8 border rounded-full font-bold" ng-click="qty = qty+1">＋</button>
                        </div>
                    </div>

                    <div class="mt-6">
                        <p class="text-sm font-semibold text-gray-700">Add-ons</p>
                        <div class="flex gap-3 mt-2">
                            <button class="px-4 py-2 bg-[#5977AF] text-white rounded-full text-sm">Card</button>
                            <button class="px-4 py-2 bg-[#5977AF] text-white rounded-full text-sm">Vase</button>
                            <button class="px-4 py-2 bg-[#5977AF] text-white rounded-full text-sm">Treats</button>
                        </div>
                    </div>

                    <div class="mt-6 grid grid-cols-2 gap-4">
                        <button class="w-full py-3 bg-[#5977AF] text-white font-bold rounded-full" ng-click="addToCart()">Add To Cart</button>
                        <button class="w-full py-3 bg-[#5977AF] text-white font-bold rounded-full" ng-click="buyNow()">Buy Now</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- lightweight loading state to avoid empty page while fetching -->
    <div class="container mx-auto px-6 py-12" ng-if="!product">
        <div class="animate-pulse">
            <div class="h-6 bg-gray-200 rounded w-1/3 mb-4"></div>
            <div class="h-64 bg-gray-200 rounded mb-6"></div>
            <div class="h-4 bg-gray-200 rounded w-2/3 mb-2"></div>
            <div class="h-4 bg-gray-200 rounded w-1/2"></div>
        </div>
    </div>

    <section class="bg-[#E0F1FF] py-12" ng-if="product">
        <div class="container mx-auto px-6">
            <h2 class="text-lg font-bold text-[#27334B] mb-4">Related Products</h2>
            <div class="flex space-x-4 pb-2 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                <div class="flex-none w-60 h-40 bg-[#DFEDF9] rounded-xl shadow-md" ng-repeat="n in [1,2,3,4,5,6,7,8]"></div>
            </div>
        </div>
    </section>
</div>