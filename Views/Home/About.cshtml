@section scripts {
    <style>
        @@keyframes marquee {
            0% {
                transform: translateX(0);
            }

            100% {
                transform: translateX(-50%);
            }
        }

        .animate-marquee {
            animation: marquee 30s linear infinite;
        }

        #testimonials-scroll:hover {
            animation-play-state: paused;
        }
    </style>
}