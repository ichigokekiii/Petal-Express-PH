@{
    ViewBag.Title = "Shop";
}

<div ng-controller="shopController" ng-click="hideDropdown()">

    <section class="bg-[#E0F1FF] py-20 text-center">
        <div class="container mx-auto px-6">
            <h1 class="text-5xl font-black text-[#27334B]" data-aos="fade-up" data-aos-duration="600">Welcome to our Online Shop</h1>
            <div data-aos="fade-up" data-aos-delay="100" data-aos-duration="600">
                @Html.Partial("_FlowerDivider")
            </div>
            <p class="mt-4 max-w-2xl mx-auto text-gray-600" data-aos="fade-up" data-aos-delay="200" data-aos-duration="600">
                Discover our beautiful collection of fresh flowers, elegant bouquets, and stunning arrangements for every occasion.
            </p>
        </div>
    </section>

    <section class="bg-white py-16 -mt-16 z-10 relative rounded-t-2xl">
        <div class="container mx-auto px-6">

            <!-- Search and Filter Bar -->
            <div class="flex flex-col md:flex-row justify-between items-center gap-6 mb-12">
                <div class="relative w-full md:w-1/3" data-aos="fade" data-aos-duration="600">
                    <input type="text" 
                           placeholder="Search products..." 
                           ng-model="searchText"
                           class="w-full px-4 py-3 border border-gray-300 rounded-full focus:outline-none focus:ring-2 focus:ring-[#5977AF]"
                           ng-focus="showDropdown = true" 
                           ng-click="$event.stopPropagation()" />
                    <button class="absolute top-1/2 right-3 -translate-y-1/2 p-2 bg-[#5977AF] rounded-full text-white">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"></path>
                        </svg>
                    </button>
                </div>
                <div class="flex items-center gap-4" data-aos="fade" data-aos-duration="600" data-aos-delay="100">
                    <select ng-model="selectedCategory" 
                            class="px-8 py-3 bg-[#5977AF] text-white font-semibold rounded-full cursor-pointer">
                        <option value="">All Categories</option>
                        <option ng-repeat="cat in categories" value="{{cat}}">{{cat}}</option>
                    </select>
                    <select ng-model="sortBy" 
                            class="px-8 py-3 bg-[#5977AF] text-white font-semibold rounded-full cursor-pointer">
                        <option value="">Sort by</option>
                        <option value="name">Name A-Z</option>
                        <option value="-name">Name Z-A</option>
                        <option value="price">Price: Low to High</option>
                        <option value="-price">Price: High to Low</option>
                    </select>
                </div>
            </div>

            <!-- Loading State -->
            <div ng-if="loading" class="text-center py-20">
                <svg class="animate-spin h-12 w-12 mx-auto text-[#5977AF]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <p class="mt-4 text-gray-600">Loading products...</p>
            </div>

            <!-- No Products Found -->
            <div ng-if="!loading && filteredProducts.length === 0" class="text-center py-20">
                <svg class="w-20 h-20 mx-auto text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
                </svg>
                <h3 class="mt-4 text-xl font-semibold text-gray-700">No products found</h3>
                <p class="mt-2 text-gray-500">Try adjusting your search or filter criteria</p>
            </div>

            <!-- Products Grid -->
            <div ng-if="!loading && filteredProducts.length > 0" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8">
                <a href="/Home/ProductDetail?id={{product.ProductId}}" 
                   class="block hover:opacity-80 transition-opacity"
                   ng-repeat="product in filteredProducts | orderBy:sortBy | limitTo:pageSize:currentPage*pageSize"
                   data-aos="fade-up"
                   data-aos-duration="500"
                   data-aos-delay="{{$index * 50}}"
                   data-aos-easing="ease-out">
                    <div>
                        <!-- Product Image -->
                        <div class="bg-[#DFEDF9] h-56 rounded-lg overflow-hidden flex items-center justify-center relative">
                            <img ng-if="product.ImagePath" 
                                 ng-src="{{product.ImagePath}}" 
                                 alt="{{product.Name}}"
                                 class="w-full h-full object-cover"
                                 onerror="this.src='/assets/default.png'" />
                            <div ng-if="!product.ImagePath" class="text-gray-400 text-center">
                                <svg class="w-16 h-16 mx-auto" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"></path>
                                </svg>
                                <p class="text-sm mt-2">No Image</p>
                            </div>
                            <!-- Stock Badge -->
                            <div ng-if="product.StockQuantity < 10" class="absolute top-2 right-2 bg-red-500 text-white text-xs px-2 py-1 rounded-full">
                                Low Stock
                            </div>
                        </div>

                        <!-- Product Info -->
                        <div class="mt-4">
                            <div class="flex justify-between items-start">
                                <h3 class="font-bold text-lg text-[#27334B] flex-1">{{product.Name}}</h3>
                                <div class="flex items-center text-sm text-gray-500 ml-2">
                                    <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                                    </svg>
                                    <span class="ml-1">4.8</span>
                                </div>
                            </div>
                            
                            <!-- Category Badge -->
                            <div class="mt-1">
                                <span class="inline-block bg-blue-100 text-blue-800 text-xs px-2 py-1 rounded-full">
                                    {{product.CategoryName}}
                                </span>
                            </div>

                            <!-- Description Preview -->
                            <p ng-if="product.Description" class="text-sm text-gray-600 mt-2 line-clamp-2">
                                {{product.Description}}
                            </p>

                            <!-- Price and Stock -->
                            <div class="mt-3 flex justify-between items-center">
                                <div class="text-[#27334B] font-semibold text-xl">₱{{product.Price | number:2}}</div>
                                <div class="text-sm" ng-class="product.StockQuantity > 10 ? 'text-green-600' : 'text-orange-600'">
                                    {{product.StockQuantity}} in stock
                                </div>
                            </div>
                        </div>
                    </div>
                </a>
            </div>

            <!-- Pagination -->
            <div ng-if="!loading && totalPages > 1" class="flex justify-center items-center space-x-4 mt-16" data-aos="fade" data-aos-duration="600">
                <button ng-click="prevPage()" 
                        class="p-2 rounded-full text-gray-400 disabled:opacity-50 hover:bg-gray-100 transition" 
                        ng-disabled="currentPage == 0">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                    </svg>
                </button>

                <button ng-repeat="page in [].constructor(totalPages) track by $index"
                        ng-click="setCurrentPage($index)"
                        ng-class="{'bg-[#27334B] text-white': currentPage == $index, 'text-gray-500 hover:bg-gray-100': currentPage != $index}"
                        class="px-4 py-2 rounded-full font-semibold transition">
                    {{$index + 1}}
                </button>

                <button ng-click="nextPage()" 
                        class="p-2 rounded-full text-gray-400 disabled:opacity-50 hover:bg-gray-100 transition" 
                        ng-disabled="currentPage >= totalPages - 1">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M7.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L10.586 10 7.293 6.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                    </svg>
                </button>
            </div>

            <!-- Product Count Info -->
            <div ng-if="!loading && filteredProducts.length > 0" class="text-center mt-8 text-gray-600">
                Showing {{(currentPage * pageSize) + 1}} - {{(currentPage * pageSize) + (filteredProducts | limitTo:pageSize:currentPage*pageSize).length}} 
                of {{filteredProducts.length}} products
            </div>

        </div>
    </section>
</div>

<style>
.line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}
</style>
