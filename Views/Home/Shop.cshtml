@model List<Petal_Express_PH.Models.tblProductsModel>
@{
    ViewBag.Title = "Shop";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 py-12">
    <div class="container mx-auto px-6 max-w-7xl">
        
        <!-- Page Header -->
        <div class="text-center mb-12">
            <h1 class="text-5xl font-black text-[#536FA3] mb-4">Our Flower Collection</h1>
            <p class="text-xl text-gray-600">Discover beautiful arrangements for every occasion</p>
        </div>

        <!-- Category Filter (Optional - can be implemented later) -->
        @if (ViewBag.Categories != null && ((List<Petal_Express_PH.Models.tblProductCategoryModel>)ViewBag.Categories).Count > 0)
        {
            <div class="flex justify-center gap-3 mb-8 flex-wrap">
                <button class="px-6 py-2 bg-[#5977AF] text-white font-semibold rounded-full hover:bg-[#4a6199] transition">
                    All
                </button>
                @foreach (var category in (List<Petal_Express_PH.Models.tblProductCategoryModel>)ViewBag.Categories)
                {
                    <button class="px-6 py-2 bg-white text-[#536FA3] font-semibold rounded-full hover:bg-gray-100 transition border-2 border-[#536FA3]">
                        @category.category_name
                    </button>
                }
            </div>
        }

        <!-- Products Grid -->
        @if (Model.Count > 0)
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                @foreach (var product in Model)
                {
                    <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl transform hover:-translate-y-2 transition duration-300">
                        <!-- Product Image -->
                        <div class="h-64 bg-gradient-to-br from-blue-50 to-indigo-100 overflow-hidden relative group">
                            @if (product.image_id != null && ViewBag.ProductImages != null && ViewBag.ProductImages.ContainsKey(product.product_id))
                            {
                                <img src="@ViewBag.ProductImages[product.product_id]" 
                                     alt="@product.name" 
                                     class="w-full h-full object-cover group-hover:scale-110 transition duration-500" />
                            }
                            else
                            {
                                <div class="w-full h-full flex items-center justify-center text-gray-300">
                                    <svg class="w-20 h-20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                    </svg>
                                </div>
                            }
                            
                            <!-- Stock Badge -->
                            @if (product.stock_quantity < 10)
                            {
                                <div class="absolute top-4 right-4 bg-red-500 text-white px-3 py-1 rounded-full text-sm font-bold">
                                    Only @product.stock_quantity left!
                                </div>
                            }
                        </div>

                        <!-- Product Info -->
                        <div class="p-5">
                            <h3 class="font-black text-xl text-gray-800 mb-2">@product.name</h3>
                            <p class="text-gray-600 text-sm mb-4 line-clamp-2">@product.description</p>
                            
                            <div class="flex justify-between items-center mb-4">
                                <span class="text-3xl font-black text-[#5977AF]">@product.price.ToString("N2")</span>
                                <span class="text-sm text-gray-500">
                                    @if (product.stock_quantity > 0)
                                    {
                                        <span class="text-green-600 font-semibold">In Stock</span>
                                    }
                                    else
                                    {
                                        <span class="text-red-600 font-semibold">Out of Stock</span>
                                    }
                                </span>
                            </div>

                            <!-- Add to Cart Button -->
                            <button onclick="addToCart(@product.product_id, '@product.name', @product.price)" 
                                    class="w-full px-6 py-3 bg-[#5977AF] text-white font-bold rounded-full hover:bg-[#4a6199] transition transform hover:scale-105"
                                    @(product.stock_quantity <= 0 ? "disabled" : "")>
                                Add to Cart
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- No Products -->
            <div class="bg-white rounded-2xl shadow-lg p-16 text-center">
                <svg class="w-32 h-32 mx-auto text-gray-300 mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                </svg>
                <h3 class="text-3xl font-black text-gray-800 mb-3">No Products Available</h3>
                <p class="text-gray-600 text-lg">Check back soon for beautiful flower arrangements!</p>
            </div>
        }

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    // Shopping Cart Array (stored in localStorage)
    let cart = JSON.parse(localStorage.getItem('petalExpressCart')) || [];

    function addToCart(productId, productName, productPrice) {
        // Check if product already in cart
        const existingItem = cart.find(item => item.productId === productId);
        
        if (existingItem) {
            existingItem.quantity += 1;
        } else {
            cart.push({
                productId: productId,
                name: productName,
                price: productPrice,
                quantity: 1
            });
        }

        // Save to localStorage
        localStorage.setItem('petalExpressCart', JSON.stringify(cart));

        // Update cart count in header
        updateCartCount();

        // Show success message
        Swal.fire({
            title: 'Added to Cart!',
            text: productName + ' has been added to your cart.',
            icon: 'success',
            confirmButtonColor: '#5977AF',
            timer: 2000,
            showConfirmButton: false
        });
    }

    function updateCartCount() {
        const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
        // Update badge in header (we'll add this later)
        console.log('Cart total items:', totalItems);
    }

    // Update cart count on page load
    updateCartCount();
</script>
