<!DOCTYPE html>
<html lang="en" ng-app="PetalExpressApplication">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Portal | Petal Express</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="bg-gray-100 font-sans" ng-controller="AdminShellCtrl">

    <div class="flex h-screen overflow-hidden">
        <aside class="w-64 bg-[#1a202c] text-white flex flex-col shadow-xl">
            <div class="h-16 flex items-center justify-center border-b border-gray-700 bg-[#2d3748]">
                <h1 class="text-xl font-bold tracking-wider"><i class="fas fa-seedling mr-2"></i>PETAL ADMIN</h1>
            </div>

            <nav class="flex-1 px-2 py-4 space-y-2 overflow-y-auto">
                <a href="@Url.Action("Dashboard", "Admin")" class="flex items-center px-4 py-3 text-gray-300 hover:bg-gray-700 hover:text-white rounded transition-colors">
                    <i class="fas fa-chart-line w-6 text-center"></i><span class="ml-3">Dashboard</span>
                </a>

                <a href="@Url.Action("Orders", "Admin")" class="flex items-center px-4 py-3 text-gray-300 hover:bg-gray-700 hover:text-white rounded transition-colors">
                    <i class="fas fa-shopping-bag w-6 text-center"></i><span class="ml-3">Orders</span>
                </a>

                <a href="@Url.Action("Products", "Admin")" class="flex items-center px-4 py-3 text-gray-300 hover:bg-gray-700 hover:text-white rounded transition-colors">
                    <i class="fas fa-box-open w-6 text-center"></i><span class="ml-3">Products</span>
                </a>

                <a href="@Url.Action("Users", "Admin")" class="flex items-center px-4 py-3 text-gray-300 hover:bg-gray-700 hover:text-white rounded transition-colors">
                    <i class="fas fa-users w-6 text-center"></i><span class="ml-3">Customers</span>
                </a>
            </nav>

            <div class="p-4 border-t border-gray-700">
                <button ng-click="logout()" class="w-full px-4 py-2 text-sm font-medium text-white bg-red-600 rounded hover:bg-red-700">Logout</button>
            </div>
        </aside>

        <div class="flex-1 flex flex-col overflow-hidden">
            <header class="h-16 flex items-center justify-between px-6 bg-white border-b shadow-sm">
                <h2 class="text-xl font-semibold text-gray-800">Admin Dashboard</h2>
                <div class="flex items-center space-x-4">
                    <span class="text-gray-600 text-sm">Welcome, <strong>@(Session["FirstName"] ?? "Admin")</strong></span>
                    <div class="h-8 w-8 rounded-full bg-blue-500 flex items-center justify-center text-white font-bold">
                        @(Session["FirstName"] != null ? Session["FirstName"].ToString().Substring(0,1) : "A")
                    </div>
                </div>
            </header>

            <main class="flex-1 overflow-x-hidden overflow-y-auto bg-gray-100">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.3/angular.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.68/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.68/vfs_fonts.js"></script>

    <script src="/Scripts/HolyScripts/Module.js"></script>
    <script src="/Scripts/HolyScripts/Service.js"></script>
    <script src="/Scripts/HolyScripts/Controller.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="/Scripts/pdfmake/pdfmake.min.js"></script>
    <script src="/Scripts/pdfmake/vfs_fonts.js"></script>
</body>
</html>