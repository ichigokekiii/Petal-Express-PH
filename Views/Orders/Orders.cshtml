@model IEnumerable<Petal_Express_PH.Models.tblOrders>
@{
    ViewBag.Title = "My Orders";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<section class="bg-white py-12">
  <div class="container mx-auto px-6 max-w-5xl">
    <h1 class="text-2xl md:text-3xl font-black text-[#27334B] mb-6">My Orders</h1>

    <div class="grid grid-cols-1 md:grid-cols-[220px_1fr] gap-8">
      <aside>
        <div class="space-y-3">
          <a href="@Url.Action("Profile","Home")" class="flex items-center gap-3 px-4 py-3 bg-[#DFEDF9] hover:bg-[#cfe3f5] rounded-lg text-[#27334B] font-bold">
            <svg class="w-6 h-6 text-[#27334B]" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            <span>My Profile</span>
          </a>
          <a href="@Url.Action("Orders","Orders")" class="flex items-center gap-3 px-4 py-3 bg-[#DFEDF9] hover:bg-[#cfe3f5] rounded-lg text-[#27334B] font-bold">
            <svg class="w-6 h-6 text-[#27334B]" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-6h13v6M9 7V4h13v3M4 4h3v17H4z"/></svg>
            <span>My Orders</span>
          </a>
        </div>
      </aside>

      <div class="bg-[#F4FAFF] rounded-xl p-6 shadow">
        <div class="flex items-center justify-between mb-4">
          <div class="flex gap-3 text-sm">
            <span class="font-bold text-[#27334B]">All</span>
            <span class="text-[#536FA3]">To Pay</span>
            <span class="text-[#536FA3]">To Ship</span>
            <span class="text-[#536FA3]">To Receive</span>
            <span class="text-[#536FA3]">Completed</span>
            <span class="text-[#536FA3]">Cancelled</span>
          </div>
          <div class="flex gap-2 items-center">
            <input type="text" class="border rounded px-3 py-2" placeholder="Search..." />
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="min-w-full text-sm">
            <thead>
              <tr class="text-[#536FA3]"><th class="py-2 px-3 text-left">Order ID</th><th class="py-2 px-3 text-left">Items</th><th class="py-2 px-3 text-left">Amount</th><th class="py-2 px-3 text-left">Status</th><th class="py-2 px-3 text-left">Placed</th></tr>
            </thead>
            <tbody>
              @foreach (var o in Model)
              {
                <tr class="border-t">
                  <td class="py-2 px-3">@o.OrderId</td>
                  <td class="py-2 px-3">@((o.ItemCount ?? 0).ToString())</td>
                  <td class="py-2 px-3">$@((o.OrderAmount ?? 0m).ToString("N2"))</td>
                  <td class="py-2 px-3">@o.OrderStatus</td>
                  <td class="py-2 px-3">@((o.CreatedAt.HasValue ? o.CreatedAt.Value.ToString("MMM dd, yyyy h:mm tt") : ""))</td>
                </tr>
              }
              @if (!Model.Any()) { <tr><td colspan="5" class="py-4 text-center text-[#536FA3]">No orders found.</td></tr>; }
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>
