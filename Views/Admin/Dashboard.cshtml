@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="p-6" ng-controller="DashboardCtrl">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold text-[#27334B]">Dashboard Overview</h2>
        <button ng-click="generateReport()" class="bg-[#5977AF] text-white px-6 py-2 rounded-full font-bold shadow hover:bg-[#4a6393] transition flex items-center gap-2">
            <i class="fas fa-file-pdf"></i> Download PDF Report
        </button>
    </div>

    <div class="bg-white p-6 rounded-2xl shadow-sm border mb-6">
        <h3 class="font-bold text-gray-700 mb-4">Total System Records</h3>
        <div class="relative h-64 w-full">
            <canvas id="overviewChart"></canvas>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white p-6 rounded-2xl shadow-sm border">
            <h3 class="font-bold text-gray-700 mb-4">Orders by Status</h3>
            <div class="relative h-64 w-full">
                <canvas id="orderChart"></canvas>
            </div>
        </div>
        <div class="bg-white p-6 rounded-2xl shadow-sm border">
            <h3 class="font-bold text-gray-700 mb-4">Products by Category</h3>
            <div class="relative h-64 w-full">
                <canvas id="categoryChart"></canvas>
            </div>
        </div>
    </div>
</div>