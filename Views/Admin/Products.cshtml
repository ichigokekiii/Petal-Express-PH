@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div ng-controller="ProductsCtrl">
    <!-- Products.cshtml -->
    <div class="products-container">
    <!-- Header -->
    <div class="page-header">
        <div>
            <h2 class="page-title">Product Management</h2>
            <p class="page-subtitle">Manage your product catalog</p>
        </div>
        <button class="btn btn-primary" ng-click="openCreate()">
            <i class="fas fa-plus"></i> Add New Product
        </button>
    </div>

    <!-- Loading State -->
    <div ng-if="loading" class="text-center" style="padding: 50px;">
        <i class="fas fa-spinner fa-spin fa-3x" style="color: #5977AF;"></i>
        <p style="margin-top: 20px; color: #6B7280;">Loading products...</p>
    </div>

    <!-- Products Table -->
    <div ng-if="!loading" class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th style="width: 80px;">Image</th>
                            <th>Product Name</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Stock</th>
                            <th style="width: 150px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-if="products.length === 0">
                            <td colspan="6" class="text-center" style="padding: 50px; color: #9CA3AF;">
                                <i class="fas fa-box-open fa-3x" style="margin-bottom: 15px; display: block;"></i>
                                No products found. Click "Add New Product" to get started.
                            </td>
                        </tr>
                        <tr ng-repeat="product in products">
                            <td>
                                <img ng-src="{{product.imagePath}}" 
                                     alt="{{product.name}}" 
                                     class="product-thumbnail"
                                     onerror="this.src='/assets/default.png'">
                            </td>
                            <td>
                                <div class="product-name">{{product.name}}</div>
                                <div class="product-description">{{product.description | limitTo:50}}{{product.description.length > 50 ? '...' : ''}}</div>
                            </td>
                            <td><span class="badge badge-category">{{product.categoryName}}</span></td>
                            <td><strong>₱{{product.price | number:2}}</strong></td>
                            <td>
                                <span class="badge" ng-class="product.stockQuantity < 10 ? 'badge-danger' : 'badge-success'">
                                    {{product.stockQuantity}} units
                                </span>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-info" ng-click="openEdit(product)" title="Edit">
                                    <i class="fas fa-edit"></i>
                                </button>
                                <button class="btn btn-sm btn-danger" ng-click="deleteProduct(product.productID, product.name)" title="Delete">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Product Form Modal -->
    <div class="modal" ng-show="showModal">
        <div class="modal-overlay" ng-click="closeModal()"></div>
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h3 ng-if="isEdit">Edit Product</h3>
                    <h3 ng-if="!isEdit">Create New Product</h3>
                    <button class="btn-close" ng-click="closeModal()">&times;</button>
                </div>
                <div class="modal-body">
                    <form ng-submit="submit()">
                        <!-- Product Name -->
                        <div class="form-group">
                            <label>Product Name <span class="text-danger">*</span></label>
                            <input type="text" 
                                   class="form-control" 
                                   ng-model="form.name" 
                                   placeholder="Enter product name" 
                                   required>
                        </div>

                        <!-- Description -->
                        <div class="form-group">
                            <label>Description</label>
                            <textarea class="form-control" 
                                      ng-model="form.description" 
                                      rows="3" 
                                      placeholder="Enter product description"></textarea>
                        </div>

                        <!-- Price & Stock (2 columns) -->
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Price (₱) <span class="text-danger">*</span></label>
                                    <input type="number" 
                                           class="form-control" 
                                           ng-model="form.price" 
                                           step="0.01" 
                                           min="0" 
                                           required>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Stock Quantity</label>
                                    <input type="number" 
                                           class="form-control" 
                                           ng-model="form.stockQuantity" 
                                           min="0">
                                </div>
                            </div>
                        </div>

                        <!-- Category -->
                        <div class="form-group">
                            <label>Category</label>
                            <select class="form-control" ng-model="form.categoryID">
                                <option value="">-- Select Category --</option>
                                <option ng-repeat="cat in categories" value="{{cat.categoryID}}">
                                    {{cat.categoryName}}
                                </option>
                            </select>
                        </div>

                        <!-- Image Upload -->
                        <div class="form-group">
                            <label>Product Image</label>
                            <div class="image-upload-container">
                                <div class="image-preview" ng-if="previewImage">
                                    <img ng-src="{{previewImage}}" alt="Preview">
                                </div>
                                <div class="image-upload-placeholder" ng-if="!previewImage">
                                    <i class="fas fa-image fa-3x"></i>
                                    <p>No image selected</p>
                                </div>
                                <input type="file" 
                                       id="productImageInput" 
                                       accept="image/*" 
                                       onchange="angular.element(this).scope().uploadImage(this)" 
                                       class="file-input">
                                <label for="productImageInput" class="btn btn-secondary">
                                    <i class="fas fa-upload"></i> 
                                    <span ng-if="uploading">Uploading...</span>
                                    <span ng-if="!uploading">Choose Image</span>
                                </label>
                            </div>
                        </div>

                        <!-- Form Actions -->
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" ng-click="closeModal()">Cancel</button>
                            <button type="submit" class="btn btn-primary" ng-disabled="uploading">
                                <i class="fas fa-save"></i> 
                                <span ng-if="isEdit">Update Product</span>
                                <span ng-if="!isEdit">Create Product</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
