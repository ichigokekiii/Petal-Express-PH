@{
    ViewBag.Title = "Products";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="p-4" ng-controller="UsersCtrl">
    <h2 class="text-xl font-bold text-[#27334B] mb-4">User Profiles</h2>

    <div class="rounded-2xl bg-white shadow-sm border p-4">
        <div class="overflow-x-auto">
            <table class="min-w-full text-sm">
                <thead>
                    <tr class="text-[#536FA3] border-b">
                        <th class="py-3 px-3 text-left">ID</th>
                        <th class="py-3 px-3 text-left">Full Name</th>
                        <th class="py-3 px-3 text-left">Email</th>
                        <th class="py-3 px-3 text-left">Role</th>
                        <th class="py-3 px-3 text-left">Joined</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat="u in users" class="border-b hover:bg-gray-50">
                        <td class="py-3 px-3 text-gray-500">{{u.userID}}</td>
                        <td class="py-3 px-3 font-semibold text-gray-700">{{u.firstName}} {{u.lastName}}</td>
                        <td class="py-3 px-3 text-blue-600">{{u.email}}</td>
                        <td class="py-3 px-3">
                            <span class="px-2 py-1 rounded text-xs font-bold uppercase"
                                  ng-class="{'bg-purple-100 text-purple-700': u.role==='admin', 'bg-gray-100 text-gray-600': u.role!=='admin'}">
                                {{u.role}}
                            </span>
                        </td>
                        <td class="py-3 px-3 text-gray-500">{{u.createdAt | date:'shortDate'}}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>