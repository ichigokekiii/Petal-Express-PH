@model Petal_Express_PH.Models.tblProductsModel
@{
    ViewBag.Title = "Create Product";
    ViewBag.PageTitle = "Add New Product";
    ViewBag.PageDescription = "Add a new product to your catalog";
    ViewBag.ActivePage = "Products";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@if (ViewBag.Error != null)
{
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg mb-6">
        <strong>Error:</strong> @ViewBag.Error
    </div>
}

<div class="max-w-4xl">
    <!-- Back Button -->
    <a href="@Url.Action("Products", "Admin")" class="inline-flex items-center text-[#5977AF] hover:text-[#4a6199] font-semibold mb-6">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Back to Products
    </a>

    <!-- Form Card -->
    <div class="bg-white rounded-2xl shadow-lg p-8">
        @using (Html.BeginForm("CreateProduct", "Admin", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            <div class="space-y-6">
                
                <!-- Product Name -->
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Product Name *</label>
                    @Html.TextBoxFor(m => m.name, new { 
                        @class = "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#5977AF] focus:border-transparent", 
                        placeholder = "e.g., Red Roses Bouquet",
                        required = "required"
                    })
                </div>

                <!-- Description -->
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Description *</label>
                    @Html.TextAreaFor(m => m.description, new { 
                        @class = "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#5977AF] focus:border-transparent", 
                        rows = "4",
                        placeholder = "Describe your product...",
                        required = "required"
                    })
                </div>

                <!-- Price and Stock -->
                <div class="grid grid-cols-2 gap-6">
                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">Price *</label>
                        @Html.TextBoxFor(m => m.price, new { 
                            @class = "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#5977AF] focus:border-transparent", 
                            type = "number",
                            step = "0.01",
                            min = "0",
                            placeholder = "0.00",
                            required = "required"
                        })
                    </div>

                    <div>
                        <label class="block text-sm font-bold text-gray-700 mb-2">Stock Quantity *</label>
                        @Html.TextBoxFor(m => m.stock_quantity, new { 
                            @class = "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#5977AF] focus:border-transparent", 
                            type = "number",
                            min = "0",
                            placeholder = "0",
                            required = "required"
                        })
                    </div>
                </div>

                <!-- Category -->
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Category *</label>
                    @Html.DropDownListFor(m => m.category_id, 
                        new SelectList(ViewBag.Categories, "category_id", "category_name"), 
                        "-- Select Category --",
                        new { 
                            @class = "w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[#5977AF] focus:border-transparent",
                            required = "required"
                        })
                </div>

                <!-- Image Upload -->
                <div>
                    <label class="block text-sm font-bold text-gray-700 mb-2">Product Image</label>
                    <div class="border-2 border-dashed border-gray-300 rounded-lg p-6 text-center hover:border-[#5977AF] transition">
                        <input type="file" 
                               name="productImage" 
                               id="productImage" 
                               accept="image/*"
                               class="hidden"
                               onchange="previewImage(event)" />
                        
                        <div id="imagePreview" class="mb-4">
                            <svg class="w-12 h-12 mx-auto text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                            </svg>
                        </div>
                        
                        <label for="productImage" class="cursor-pointer px-6 py-2 bg-[#5977AF] text-white font-semibold rounded-lg hover:bg-[#4a6199] transition inline-block">
                            Choose Image
                        </label>
                        <p class="text-sm text-gray-500 mt-2">PNG, JPG, GIF up to 10MB</p>
                    </div>
                </div>

                <!-- Submit Buttons -->
                <div class="flex gap-4 pt-4">
                    <button type="submit" class="flex-1 px-6 py-3 bg-[#5977AF] text-white font-bold rounded-lg hover:bg-[#4a6199] transition">
                        Create Product
                    </button>
                    <a href="@Url.Action("Products", "Admin")" class="flex-1 px-6 py-3 bg-gray-300 text-gray-700 font-bold rounded-lg hover:bg-gray-400 transition text-center">
                        Cancel
                    </a>
                </div>

            </div>
        }
    </div>
</div>

<script>
    function previewImage(event) {
        const preview = document.getElementById('imagePreview');
        const file = event.target.files[0];
        
        if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
                preview.innerHTML = '<img src="' + e.target.result + '" class="max-h-64 mx-auto rounded-lg" />';
            }
            reader.readAsDataURL(file);
        }
    }
</script>
