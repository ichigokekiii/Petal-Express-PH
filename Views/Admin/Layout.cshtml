@{
    Layout = null;
}
<!doctype html>
<html ng-app="petalAdminApp">
<head>
    <meta charset="utf-8" />
    <title>Petal Express PH - Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;700;900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body {
            font-family: 'Montserrat', sans-serif;
        }

        .side-link.active {
            background-color: #5977AF;
            color: #fff;
        }
    </style>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-[#E0F1FF]" ng-controller="AdminShellCtrl">
    <div class="min-h-screen flex">
        <!-- Sidebar -->
        <aside class="w-64 bg-white border-r shadow-sm">
            <div class="p-6 border-b flex items-center gap-3">
                <div class="h-8 w-8 rounded-full bg-[#5977AF]"></div>
                <div>
                    <h4 class="m-0 font-black text-[#536FA3] leading-tight">Petal Express</h4>
                    <small class="text-gray-500">Admin</small>
                </div>
            </div>
            <nav class="p-4 space-y-1">
                <a class="block px-4 py-2 rounded-full text-sm font-bold text-[#536FA3] hover:text-white hover:bg-[#5977AF] side-link" ng-class="{active:isActive('/dashboard')}" href="#/dashboard">Dashboard</a>
                <a class="block px-4 py-2 rounded-full text-sm font-bold text-[#536FA3] hover:text-white hover:bg-[#5977AF] side-link" ng-class="{active:isActive('/analytics')}" href="#/analytics">Analytics</a>
                <a class="block px-4 py-2 rounded-full text-sm font-bold text-[#536FA3] hover:text-white hover:bg-[#5977AF] side-link" ng-class="{active:isActive('/products')}" href="#/products">Products</a>
                <a class="block px-4 py-2 rounded-full text-sm font-bold text-[#536FA3] hover:text-white hover:bg-[#5977AF] side-link" ng-class="{active:isActive('/inventory')}" href="#/inventory">Inventory</a>
                <a class="block px-4 py-2 rounded-full text-sm font-bold text-[#536FA3] hover:text-white hover:bg-[#5977AF] side-link" ng-class="{active:isActive('/orders')}" href="#/orders">Orders</a>
                <a class="block px-4 py-2 rounded-full text-sm font-bold text-[#536FA3] hover:text-white hover:bg-[#5977AF] side-link" ng-class="{active:isActive('/schedules')}" href="#/schedules">Schedules</a>
                <a class="block px-4 py-2 rounded-full text-sm font-bold text-[#536FA3] hover:text-white hover:bg-[#5977AF] side-link" ng-class="{active:isActive('/profiles')}" href="#/profiles">Profiles</a>
                <a class="block px-4 py-2 rounded-full text-sm font-bold text-[#536FA3] hover:text-white hover:bg-[#5977AF] side-link" ng-class="{active:isActive('/logs')}" href="#/logs">Logs</a>
                <a class="block px-4 py-2 rounded-full text-sm font-bold text-[#536FA3] hover:text-white hover:bg-[#5977AF] side-link" ng-class="{active:isActive('/settings')}" href="#/settings">Settings</a>
            </nav>
            <div class="p-4">
                <button class="w-full px-4 py-2 rounded-full bg-[#5977AF] text-white text-sm font-bold">Create Now +</button>
            </div>
        </aside>

        <!-- Main -->
        <div class="flex-1 flex flex-col">
            <!-- Topbar -->
            <header class="flex items-center justify-between px-6 py-4 bg-[#F4FAFF] border-b">
                <div class="flex items-center gap-3">
                    <h5 class="m-0 font-bold text-[#27334B]">{{activeTitle}}</h5>
                    <div class="flex items-center gap-2 text-[#536FA3]">
                        <span>??</span><span>??</span><span>??</span>
                    </div>
                </div>
                <div class="flex items-center gap-3">
                    <div class="rounded-full bg-gray-400" style="width:32px;height:32px;"></div>
                    <span class="text-gray-600">User Admin</span>
                    <button class="px-4 py-1 rounded-full bg-[#5977AF] text-white text-sm font-bold" ng-click="logout()">Logout</button>
                </div>
            </header>

            <!-- Angular view area -->
            <main class="p-6">
                <div ng-view></div>
            </main>
        </div>
    </div>

    @RenderBody()

    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.3/angular.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.3/angular-route.min.js"></script>
    <script src="~/Scripts/admin/app.js"></script>
    <script src="~/Scripts/admin/controllers.js"></script>
    <script src="~/Scripts/admin/services.js"></script>
    <script>
        // Helper to reflect active state on sidebar and header title
        angular.module('petalAdminApp').run(['$rootScope', '$location', function ($rootScope, $location) {
            $rootScope.isActive = function (path) { return $location.path() === path; };
            var titles = {
                '/dashboard': 'Dashboard', '/analytics': 'Analytics', '/products': 'Products', '/inventory': 'Inventory', '/orders': 'Orders', '/schedules': 'Schedules', '/profiles': 'Profiles', '/logs': 'Logs', '/settings': 'Settings'
            };
            $rootScope.activeTitle = titles[$location.path()] || 'Dashboard';
            $rootScope.$on('$routeChangeSuccess', function () { $rootScope.activeTitle = titles[$location.path()] || 'Dashboard'; });
        }]);
    </script>
</body>
</html>
