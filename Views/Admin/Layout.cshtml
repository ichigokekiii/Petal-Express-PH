<!DOCTYPE html>
<html ng-app="PetalExpressApplication">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Petal Express PH</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body class="bg-gray-50 text-gray-800" ng-controller="mainController">

    <nav class="bg-white shadow-sm border-b px-6 py-4 flex justify-between items-center">
        <a href="/Home/Index" class="text-xl font-black text-[#536FA3] no-underline">
            Petal Express
        </a>
        <div class="space-x-4">
            <a href="/Home/Index" class="text-gray-600 hover:text-[#5977AF] font-bold no-underline">Home</a>
            <a href="/Home/Shop" class="text-gray-600 hover:text-[#5977AF] font-bold no-underline">Shop</a>
            <a href="/Home/Login" class="px-4 py-2 bg-[#5977AF] text-white rounded-full font-bold hover:bg-[#4a6393] no-underline transition" ng-if="!api.isLoggedIn">
                Login
            </a>
            <button ng-click="logout()" class="text-red-500 font-bold hover:underline" ng-if="api.isLoggedIn">
                Logout
            </button>
        </div>
    </nav>

    <div class="min-h-screen">
        @RenderBody()
    </div>

    <footer class="bg-white border-t mt-auto py-6 text-center text-gray-500 text-sm">
        <p>&copy; @DateTime.Now.Year - Petal Express PH</p>
    </footer>

    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.3/angular.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/angularjs/1.8.3/angular-route.min.js"></script>

    <script src="~/Scripts/HolyScripts/Module.js"></script>

    <script src="~/Scripts/HolyScripts/Service.js"></script>

    <script src="~/Scripts/HolyScripts/Controller.js"></script>

    @RenderSection("scripts", required: false)
</body>
</html>